DOMAIN=example.test-domain.ru
PREVIEW_DOMAIN=preview.example.test-domain.ru
ACME_EMAIL=admin@example.com
CORS_ORIGINS=https://example.test-domain.ru,https://www.example.test-domain.ru,https://preview.example.test-domain.ru

POSTGRES_DB=realdate
POSTGRES_USER=realdate
POSTGRES_PASSWORD=generate-a-long-random-password
DATABASE_URL=postgresql+asyncpg://realdate:URL_ENCODED_PASSWORD@db:5432/realdate
JWT_SECRET=generate-at-least-64-random-characters
ADMIN_PHONE=+79990000000
ADMIN_PHONES=+79990000000,+79990000001

# console | telegram | smsru | smsaero
OTP_PROVIDER=telegram

# Telegram Gateway: https://gateway.telegram.org/
TELEGRAM_GATEWAY_TOKEN=
TELEGRAM_SENDER_USERNAME=

# SMS.ru: ключ api_id из личного кабинета
SMSRU_API_ID=
SMSRU_FROM=REALDATE

# SMS Aero: email-логин, API-ключ и доступная подпись отправителя
SMSAERO_EMAIL=
SMSAERO_API_KEY=
SMSAERO_SIGN=SMSAero
