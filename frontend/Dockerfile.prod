FROM node:22-alpine AS build
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile
COPY . .
ARG VITE_API_URL=/api
ARG VITE_PUBLIC_SITE_URL=https://realdatequickly.ru
ARG VITE_LEGAL_NAME
ARG VITE_LEGAL_INN
ARG VITE_LEGAL_ADDRESS
ARG VITE_SUPPORT_PHONE=+79990800137
ARG VITE_SUPPORT_EMAIL
ARG VITE_SUPPORT_TELEGRAM=katy_sha_00
ARG VITE_DOCUMENTS_EFFECTIVE_DATE
ENV VITE_API_URL=$VITE_API_URL \
    VITE_PUBLIC_SITE_URL=$VITE_PUBLIC_SITE_URL \
    VITE_LEGAL_NAME=$VITE_LEGAL_NAME \
    VITE_LEGAL_INN=$VITE_LEGAL_INN \
    VITE_LEGAL_ADDRESS=$VITE_LEGAL_ADDRESS \
    VITE_SUPPORT_PHONE=$VITE_SUPPORT_PHONE \
    VITE_SUPPORT_EMAIL=$VITE_SUPPORT_EMAIL \
    VITE_SUPPORT_TELEGRAM=$VITE_SUPPORT_TELEGRAM \
    VITE_DOCUMENTS_EFFECTIVE_DATE=$VITE_DOCUMENTS_EFFECTIVE_DATE
RUN pnpm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
